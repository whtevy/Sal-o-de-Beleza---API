{
  "name": "salao-api",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de salão de beleza",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "@types/swagger-ui-express": "^4.1.8",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.3",
    "@types/supertest": "^6.0.3"
  }
}
